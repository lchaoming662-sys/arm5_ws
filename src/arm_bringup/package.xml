<?xml version="1.0"?>
<?xml-model href="http://download.ros.org/schema/package_format3.xsd" schematypens="http://www.w3.org/2001/XMLSchema"?>
<package format="3">
  <name>arm_bringup</name>
  <version>0.1.0</version>
  <description>O5-2 机械臂的总装入口（bringup）：控制器配置 + 一条命令拉起仿真与 MoveIt</description>
  <maintainer email="lchaoming662@gmail.com">黎超明</maintainer>
  <license>MIT</license>

  <buildtool_depend>ament_cmake</buildtool_depend>

  <exec_depend>rclpy</exec_depend>
  <exec_depend>controller_manager</exec_depend>
  <exec_depend>controller_manager_msgs</exec_depend>
  <exec_depend>joint_trajectory_controller</exec_depend>
  <!-- 夹爪用的 position_controllers/GripperActionController 在这个包里 -->
  <exec_depend>gripper_controllers</exec_depend>
  <exec_depend>joint_state_broadcaster</exec_depend>
  <exec_depend>xacro</exec_depend>
  <exec_depend>robot_state_publisher</exec_depend>
  <!-- bringup.launch.py 会把这两个包 include 进来 -->
  <exec_depend>arm_description</exec_depend>
  <exec_depend>arm_gazebo</exec_depend>
  <exec_depend>arm_moveit_config</exec_depend>

  <export>
    <build_type>ament_cmake</build_type>
  </export>
</package>
