<?xml version="1.0"?>
<?xml-model href="http://download.ros.org/schema/package_format3.xsd" schematypens="http://www.w3.org/2001/XMLSchema"?>
<package format="3">
  <name>arm_bringup</name>
  <version>0.1.0</version>
  <description>O5-2 机械臂的总装入口（bringup）：控制器配置 + 一条命令拉起仿真与 MoveIt</description>
  <maintainer email="lchaoming662@gmail.com">黎超明</maintainer>
  <license>MIT</license>

  <buildtool_depend>ament_cmake</buildtool_depend>

  <exec_depend>rclpy</exec_depend>
  <exec_depend>controller_manager</exec_depend>
  <exec_depend>controller_manager_msgs</exec_depend>
  <exec_depend>joint_trajectory_controller</exec_depend>
  <!-- 夹爪用的 position_controllers/GripperActionController 在这个包里 -->
  <exec_depend>gripper_controllers</exec_depend>
  <exec_depend>joint_state_broadcaster</exec_depend>
  <exec_depend>xacro</exec_depend>
  <exec_depend>robot_state_publisher</exec_depend>
  <!-- bringup.launch.py 会把这两个包 include 进来 -->
  <exec_depend>arm_description</exec_depend>
  <exec_depend>arm_gazebo</exec_depend>
  <exec_depend>arm_moveit_config</exec_depend>

  <!-- MTC 抓取流水线：grasp_mtc.launch.py + scripts/grasp_pipeline_mtc.py。
       MTC 的 Python 绑定在 core 包里，且建在 rclcpp 上（不是 rclpy），
       所以还需要 py_binding_tools 提供 rclcpp 的 Python 模块。 -->
  <exec_depend>moveit_task_constructor_core</exec_depend>
  <exec_depend>moveit_msgs</exec_depend>
  <exec_depend>geometry_msgs</exec_depend>
  <exec_depend>shape_msgs</exec_depend>
  <exec_depend>py_binding_tools</exec_depend>
  <!-- tools/scene_object.py 用 rclpy，它把目标加进 move_group 的规划场景 -->
  <exec_depend>rclpy</exec_depend>

  <export>
    <build_type>ament_cmake</build_type>
  </export>
</package>
