<?xml version="1.0" ?>
<!--
  arm_world.sdf — O5-2 机械臂的仿真世界（Gazebo Fortress / SDF 1.8）

  SDF 和 URDF 是两种格式，别混：
      URDF/xacro 描述「机器人」（link + joint）→ robot_state_publisher 读
      SDF        描述「世界」（地面、光照、物理、静物）→ Gazebo 本身读

  校验： ign sdf -k arm_world.sdf   → 期望输出 Valid.

  ============================================================================
  目标方块的尺寸与位置由夹爪几何反推，不是随手定的
  ============================================================================

  · 尺寸 25 mm
        零位两指夹持面间距 29.28 mm，方块要明显小于它才夹得住；
        25 mm 时每侧留 2.14 mm 余量。

  · 位置 (0.0267, 0.0245, 0.0125)
        x、y 取自抓取位形的 TCP 水平坐标；z = 半边长，让底面正好贴地。

  · 抓取位形  lower_arm_joint=-0.37  upper_arm_joint=-0.31  wrist_joint=-1.51（top_plate_joint=claw_base_joint=0）
        此时 TCP z = 0.0231，两指夹持范围 z ∈ [0.0046, 0.0416]，
        指尖离地 4.6 mm —— 刚好把 25 mm 方块完整包住又不插进地面。

  注意：这条臂「两指竖直朝下且指尖不破地面」的 TCP 高度窗口很窄
     （z ∈ [0.023, 0.039]，只有 16 mm），所以方块只能放地面，
     放到哪怕是 30 mm 高的台面上都够不着。
     改动方块高度前请重跑 tools/ 里的位形核算。
-->
<sdf version="1.8">
  <world name="arm_world">

    <!-- ==================== 1. 物理引擎 ====================
         这是本仿真**主要的性能旋钮**。
           实测（本机 20 核、软件渲染）：物理是单线程的，server 进程稳定吃满
           1 个核，实时因子被压在 0.14 —— 也就是说仿真里 1 秒的动作要跑 7 秒。
           把相机从 640x480@30 降到 320x240@10 后 RTF 一点没变，说明渲染
           并没有阻塞物理循环，瓶颈就是物理步进本身。

           max_step_size 1 ms → 3 ms（1000 Hz → 333 Hz），物理开销直接降到 1/3。
           3 ms 对这条臂足够：位置伺服本身不快，控制器又是 100 Hz。

           注意：再往上加（>5 ms）会让抓取时的接触解算变糙，方块可能滑动或抖。
              如果看到方块被夹住后还在颤，先把这个值调回 0.002。
           注意：real_time_factor 是**上限**不是保证值：填 1.0 表示"能多快就多快，
              但不超过真实时间"。填 0 才是"不计现实时间、全力跑"。
         ==================================================== -->
    <physics name="3ms" type="ignored">
      <max_step_size>0.003</max_step_size>
      <real_time_factor>1.0</real_time_factor>
    </physics>

    <!-- ==================== 2. 系统插件 ====================
         前三个是 Fortress 的最小必需集，少一个世界就跑不起来：
             Physics           物理引擎（重力、碰撞）——缺了什么都不动
             UserCommands      允许外部下命令（生成机器人）——缺了 spawn 失败
             SceneBroadcaster  对外发布场景信息——缺了界面一片空白
         Sensors 是本项目额外需要的：腕部相机靠它出图。
         ==================================================== -->
    <plugin filename="ignition-gazebo-physics-system"
            name="ignition::gazebo::systems::Physics"/>
    <plugin filename="ignition-gazebo-user-commands-system"
            name="ignition::gazebo::systems::UserCommands"/>
    <plugin filename="ignition-gazebo-scene-broadcaster-system"
            name="ignition::gazebo::systems::SceneBroadcaster"/>
    <plugin filename="ignition-gazebo-sensors-system"
            name="ignition::gazebo::systems::Sensors">
      <render_engine>ogre2</render_engine>
    </plugin>

    <!-- ==================== 3. 光照 ==================== -->
    <light type="directional" name="sun">
      <cast_shadows>true</cast_shadows>
      <pose>0 0 10 0 0 0</pose>
      <diffuse>0.8 0.8 0.8 1</diffuse>
      <specular>0.2 0.2 0.2 1</specular>
      <direction>-0.5 0.1 -0.9</direction>
    </light>

    <!-- ==================== 4. 地面 ====================
         机械臂生成在 z=0，底座落在这张面上；目标方块也直接放在这张面上。
         ==================================================== -->
    <model name="ground_plane">
      <static>true</static>
      <link name="link">
        <collision name="collision">
          <geometry>
            <plane><normal>0 0 1</normal><size>20 20</size></plane>
          </geometry>
        </collision>
        <visual name="visual">
          <geometry>
            <plane><normal>0 0 1</normal><size>20 20</size></plane>
          </geometry>
          <material>
            <ambient>0.75 0.75 0.75 1</ambient>
            <diffuse>0.75 0.75 0.75 1</diffuse>
          </material>
        </visual>
      </link>
    </model>

    <!-- ==================== 5. 被抓取的目标方块 ====================
         注意：没有 <static>：它是可动物体，被夹住后能真的被提起来。
         注意：有 <inertial>：动力学物体必须有质量和惯量，否则 Gazebo 会警告
            并把它当静态处理（那样就永远「提不动」）。
         注意：摩擦 mu 取 1.2：低于夹爪指的 1.50（见 arm_gz.urdf.xacro），
            这样夹持时摩擦由「滑块-方块」这一对决定，抓得住。
         ============================================================ -->
    <model name="target_cube">
      <pose>0.0267 0.0245 0.0125 0 0 0</pose>
      <link name="link">
        <inertial>
          <mass>0.020</mass>
          <inertia>
            <ixx>2.083e-06</ixx><ixy>0</ixy><ixz>0</ixz>
            <iyy>2.083e-06</iyy><iyz>0</iyz>
            <izz>2.083e-06</izz>
          </inertia>
        </inertial>
        <collision name="collision">
          <geometry><box><size>0.025 0.025 0.025</size></box></geometry>
          <surface>
            <friction>
              <ode><mu>1.2</mu><mu2>1.2</mu2></ode>
            </friction>
          </surface>
        </collision>
        <visual name="visual">
          <geometry><box><size>0.025 0.025 0.025</size></box></geometry>
          <material>
            <ambient>0.2 0.6 0.9 1</ambient>
            <diffuse>0.2 0.6 0.9 1</diffuse>
          </material>
        </visual>
      </link>
    </model>

  </world>
</sdf>
