<?xml version="1.0"?>
<!--
  arm_camera.xacro — 腕部相机（eye-in-hand）

  ============================================================================
  注意：尺寸说明
  ============================================================================
  下面用的是「虚构占位尺寸」，不对应任何真实相机型号。
  尺寸选型尚未定案（ESP32-CAM 因 JPEG 压缩破坏角点亚像素精度、WiFi 延迟高、
  单目无深度，已论证不适合做核心标定与闭环；最终可能改用 USB 相机或 RealSense）。
  换相机时只改本文件的 arm_camera 宏参数

  ============================================================================
  安装设计
  ============================================================================
      安装面  ：claw_base 的 +Y 面（2 mm 板，零位时最高面 y = +0.0070）
                模块「立在」腕板顶上，不是挂在侧面
      光轴    ：在 TCP 前方约 150 mm 处与夹爪接近轴汇合，即相对水平面下倾 5.1°
      镜头高度：在夹爪尖上方 14.3 mm（这样夹爪落在画面下部，不遮挡目标）

  坐标系链：claw_base -> wrist_cam_link -> wrist_cam_optical_frame
      光学坐标系遵循 REP-103（z 前 / x 右 / y 下），
      image 与 camera_info 的 frame_id 用 wrist_cam_optical_frame。

  ============================================================================
  关于传感器：本文件用 Gazebo **Fortress（gz-sim 6）** 语法
  ============================================================================
  · 传感器类型是 rgbd_camera，同时出彩色图、深度图与点云，共四个 gz 话题：
        /wrist_cam/image         （彩色）
        /wrist_cam/depth_image   （深度）
        /wrist_cam/points        （点云）
        /wrist_cam/camera_info   （内参）
    它们都要经 ros_gz_bridge 才能变成 ROS 2 话题 —— 彩色与深度走
    ros_gz_image 的 image_bridge，点云与内参走 parameter_bridge，
    对应 arm_gazebo/launch/gz_launch.py 与 arm_gazebo/config/arm_bridge.yaml。
  · 不要在这里加 libgazebo_ros_camera.so：那是 Gazebo Classic 的写法，
    Fortress 里找不到这个插件，会静默不发图。
  · <gz_frame_id> 只负责给消息盖 frame_id 戳，不改变传感器朝向。
    传感器固定沿所在 link 的 +X 看（镜头圆柱也装在 +X 侧）。
-->
<robot xmlns:xacro="http://www.ros.org/wiki/xacro">

  <xacro:property name="color_cam_body" value="0.10 0.11 0.13 1.0"/>
  <xacro:property name="color_cam_lens" value="0.05 0.05 0.06 1.0"/>
  <xacro:property name="cam_deg_to_rad" value="0.01745329252"/>

  <material name="cam_body_color"><color rgba="${color_cam_body}"/></material>
  <material name="cam_lens_color"><color rgba="${color_cam_lens}"/></material>

  <xacro:macro name="arm_camera" params="enable_sensor:=true">

    <!-- ============================================================
         一、相机本体 link
         由 3 个几何体拼成：底脚 + 主板 + 镜头
         ============================================================ -->
    <link name="wrist_cam_link">

      <!-- 底脚（平贴腕板） -->
      <visual>
        <origin xyz="0.000000 0.000000 -0.012545" rpy="1.655340 -0.000000 -1.570796"/>
        <geometry><box size="0.022000 0.005000 0.020000"/></geometry>
        <material name="cam_body_color"/>
      </visual>

      <!-- 主板 -->
      <visual>
        <origin xyz="0 0 0" rpy="0 0 0"/>
        <geometry><box size="0.007000 0.024000 0.020000"/></geometry>
        <material name="cam_body_color"/>
      </visual>

      <!-- 镜头 -->
      <visual>
        <origin xyz="0.007500 0 0" rpy="0 1.5707963 0"/>
        <geometry><cylinder radius="0.005000" length="0.008000"/></geometry>
        <material name="cam_lens_color"/>
      </visual>

      <!-- 碰撞体：用主板 box 近似整个模块 -->
      <collision>
        <origin xyz="0 0 0" rpy="0 0 0"/>
        <geometry><box size="0.007000 0.024000 0.020000"/></geometry>
      </collision>

      <!-- 质量 10 g，惯量按 7×24×20 mm 长方体估算 -->
      <inertial>
        <origin xyz="0 0 0" rpy="0 0 0"/>
        <mass value="0.010"/>
        <inertia ixx="0.000000813" ixy="0" ixz="0"
                 iyy="0.000000374" iyz="0" izz="0.000000521"/>
      </inertial>
    </link>

    <!-- ============================================================
         二、安装关节：claw_base -> 相机本体
         原点 (0, 0.022, -0.027)、rpy (-π, 1.486253, -π/2)
         这是「旋转 + 倾斜」复合变换，由几何求解得出。
         ============================================================ -->
    <joint name="wrist_cam_mount_joint" type="fixed">
      <parent link="claw_base"/>
      <child  link="wrist_cam_link"/>
      <origin xyz="0.000000 0.022000 -0.027000" rpy="-3.141593 1.486253 -1.570796"/>
    </joint>

    <!-- ============================================================
         三、光学坐标系（空 link）

         body 系(+X 前 +Z 上) -> optical 系(+Z 前 +X 右 +Y 下)
         标准变换：先绕 X 转 -90°，再绕 Z 转 -90°
         ============================================================ -->
    <link name="wrist_cam_optical_frame"/>

    <joint name="wrist_cam_optical_joint" type="fixed">
      <parent link="wrist_cam_link"/>
      <child  link="wrist_cam_optical_frame"/>
      <origin xyz="0 0 0" rpy="${-pi/2} 0 ${-pi/2}"/>
    </joint>

    <!-- ============================================================
         四、Gazebo Fortress 深度相机传感器（RGBD）

         换相机时改这里的 fov / 分辨率 / 噪声参数
         话题见文件头「关于传感器」，共 image / depth_image / points / camera_info

         为什么是 rgbd_camera 而不是 camera：
           抓取流水线要的是物体的三维位姿。单目 RGB 只能靠「已知边长 + PnP」
           反推，物体尺寸未知或颜色不分时就没办法；RGBD 直接给点云，物体位姿
           可以从平面分割 + 欧式聚类得到，不依赖任何先验。
           真机选型也倾向深度相机（见文件头「尺寸说明」），仿真与真机保持一致。

         注意：update_rate 与分辨率直接决定仿真能不能跑快，而深度渲染比彩色贵。
           Fortress 的 Sensors 系统在 PostUpdate 里等渲染线程出图，相机一慢，
           整个仿真循环就被它拖住。本机是软件渲染（llvmpipe），所以按
           320x240@10Hz 起步，实测实时因子后再定要不要再降。

         注意：只有**传感器**受 enable_sensor 控制，上面的 link 与关节始终存在。
            （SRDF 里引用了 wrist_cam_link / wrist_cam_optical_frame 做碰撞
             矩阵，link 一旦缺失 MoveIt 会报未知连杆。）
            关掉传感器省的是渲染开销。
         ============================================================ -->
    <xacro:if value="${enable_sensor}">
    <gazebo reference="wrist_cam_link">
      <sensor name="wrist_cam" type="rgbd_camera">
        <pose>0 0 0 0 0 0</pose>
        <always_on>1</always_on>
        <update_rate>10</update_rate>
        <visualize>false</visualize>
        <topic>wrist_cam</topic>
        <gz_frame_id>wrist_cam_optical_frame</gz_frame_id>
        <camera name="wrist_cam">
          <horizontal_fov>${60.0 * cam_deg_to_rad}</horizontal_fov>
          <image>
            <width>320</width>
            <height>240</height>
            <format>R8G8B8</format>
          </image>
          <clip>
            <near>0.02</near>
            <far>10</far>
          </clip>
          <!--
            注意：这个 stddev 会同时作用在彩色图和深度图上，而且作用在深度上时
            单位是【米】。原来写 0.007，等于给深度加了 7 mm 噪声 —— 目标方块才
            25 mm 高，噪声直接把它淹掉：实测地面点的 z 散成 ±20 mm，任何靠 z 阈值
            的地面分割都会失效（分出来的是一个 160x120 mm 的薄片，不是那个方块）。

            真实深度相机在 10 cm 处的深度噪声不到 2 mm（这也是本臂的典型观测
            距离），所以取 0.001：彩色图仍有轻微噪声，深度 1 mm 也符合该距离下
            的实际水平。要做抗噪鲁棒性测试时再单独调大，别把它当默认值留在模型里。
          -->
          <noise>
            <type>gaussian</type>
            <mean>0.0</mean>
            <stddev>0.001</stddev>
          </noise>
        </camera>
      </sensor>
    </gazebo>
    </xacro:if>

  </xacro:macro>

</robot>
